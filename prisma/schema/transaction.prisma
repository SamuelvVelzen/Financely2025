// ----------
// Transactions
// ----------

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
}

enum TransferDirection {
  OUT
  IN
}

enum TimePrecision {
  DateTime
  DateOnly
}

model Transaction {
  id              String          @id @default(cuid())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  workspaceId     Int
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type            TransactionType
  transferDirection TransferDirection?
  transferGroupId   String?
  ledgerAccountId   String?
  ledgerAccount     LedgerAccount?    @relation(fields: [ledgerAccountId], references: [id], onDelete: SetNull)
  amount          Decimal
  currency        String
  transactionDate DateTime
  timePrecision   TimePrecision   @default(DateTime)
  name            String
  description     String?
  notes           String?
  externalId      String?
  paymentMethod   String
  tags            Tag[]
  primaryTagId    String?
  primaryTag      Tag?            @relation("PrimaryTag", fields: [primaryTagId], references: [id])
  subscriptionId  String?
  subscription    Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  splitExpenseShareId String?     @unique
  splitExpenseShare   SplitExpenseShare? @relation(fields: [splitExpenseShareId], references: [id], onDelete: SetNull)
  splitSyncDetachedAt DateTime?
  refundAllocations        TransactionRefundAllocation[] @relation("RefundAllocations")
  expenseRefundAllocations TransactionRefundAllocation[] @relation("ExpenseRefundAllocations")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, transactionDate])
  @@index([userId, type, transactionDate])
  @@index([workspaceId, transactionDate])
  @@index([workspaceId, type, transactionDate])
  @@index([subscriptionId])
  @@index([ledgerAccountId, transactionDate])
  @@index([transferGroupId])
}

model TransactionRefundAllocation {
  id                   String   @id @default(cuid())
  refundTransactionId  String
  expenseTransactionId String
  amount               Decimal
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  refundTransaction  Transaction @relation("RefundAllocations", fields: [refundTransactionId], references: [id], onDelete: Cascade)
  expenseTransaction Transaction @relation("ExpenseRefundAllocations", fields: [expenseTransactionId], references: [id], onDelete: Cascade)

  @@unique([refundTransactionId, expenseTransactionId])
  @@index([expenseTransactionId])
}
