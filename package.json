{
  "name": "financely",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && vite dev",
    "build": "prisma generate && vite build && tsx scripts/generate-sw.ts",
    "build:cf": "yarn build",
    "preview": "vite preview",
    "deploy": "yarn build && wrangler deploy --config dist/server/wrangler.json",
    "cf-typegen": "wrangler types",
    "pwa:sw": "tsx scripts/generate-sw.ts",
    "db:d1:migrate:local": "tsx scripts/apply-prisma-migrations-to-d1.ts",
    "db:d1:migrate:remote": "tsx scripts/apply-prisma-migrations-to-d1.ts --remote",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check": "yarn typecheck && yarn lint && yarn test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:features": "playwright test --project=features",
    "test:e2e:ui": "playwright test --ui",
    "playwright:install": "playwright install chromium",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "db:reset": "rm -f prisma/data/dev.db prisma/data/dev.db-journal prisma/data/dev.db-wal prisma/data/dev.db-shm && prisma migrate dev",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-d1": "6.17.1",
    "@prisma/client": "6.17.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "@tanstack/react-router": "^1.133.36",
    "@tanstack/react-start": "^1.134.3",
    "better-auth": "^1.4.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "prisma": "^6.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.66.0",
    "react-icons": "^5.5.0",
    "react-number-format": "^5.4.5",
    "workbox-window": "^7.4.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.17.6",
    "@cloudflare/workers-types": "^5.20261116.1",
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prisma-zod-generator": "1.32.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "typescript-eslint": "^8.62.0",
    "vite": "^7.1.12",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "workbox-build": "^7.4.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "wrangler": "^4.54.0"
  },
  "packageManager": "yarn@4.18.1"
}
